rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each household lives under a long random code (the household id).
    // Access is per person: a signed-in user needs a document at households/<hid>/members/<their uid>.
    //   owner  – the two household members, signed in with Google. Full access.
    //   sitter – a temporary helper (anonymous sign-in + an invite link + a PIN). Can read events and settings,
    //            add events, and edit or delete only their own events. Access ends at the invite's expiry.
    match /households/{hid} {
      function validHid() { return hid.size() >= 18; }
      function signedIn() { return request.auth != null; }
      function membersPath(uid) { return /databases/$(database)/documents/households/$(hid)/members/$(uid); }
      function ownersPath() { return /databases/$(database)/documents/households/$(hid)/meta/owners; }

      // The caller's own membership record, if it exists and hasn't expired.
      function memberData() { return get(membersPath(request.auth.uid)).data; }
      function activeMember() {
        return signedIn() && exists(membersPath(request.auth.uid))
          && (!('expiresAt' in memberData()) || memberData().expiresAt > request.time);
      }
      function isOwner() {
        return validHid() && activeMember() && get(membersPath(request.auth.uid)).data.role == 'owner';
      }

      function isSitter() {
        return validHid() && activeMember() && memberData().role == 'sitter';
      }
      function invitePath(id) { return /databases/$(database)/documents/households/$(hid)/invites/$(id); }
      function pinPath(id) { return /databases/$(database)/documents/households/$(hid)/invitePins/$(id); }
      function eventFields() { return ['type', 'at', 'by', 'byUid', 'grams', 'shape', 'colour', 'note']; }
      // A sitter claims their own record by proving they know the invite's PIN. The record must mirror the invite
      // (name, start and end) so a sitter can't write themselves a longer stay.
      function sitterClaim() {
        let d = request.resource.data;
        return request.auth.token.firebase.sign_in_provider == 'anonymous'
          && d.keys().hasOnly(['role', 'name', 'startsAt', 'expiresAt', 'inviteId', 'pin'])
          && d.role == 'sitter' && d.inviteId is string && d.inviteId.size() >= 16
          && exists(invitePath(d.inviteId)) && exists(pinPath(d.inviteId))
          && get(pinPath(d.inviteId)).data.pin == d.pin
          && d.name == get(invitePath(d.inviteId)).data.name
          && d.startsAt == get(invitePath(d.inviteId)).data.startsAt
          && d.expiresAt == get(invitePath(d.inviteId)).data.expiresAt
          && get(invitePath(d.inviteId)).data.startsAt <= request.time
          && get(invitePath(d.inviteId)).data.expiresAt > request.time;
      }

      // Only a verified Google account can be an owner.
      function googleEmail() {
        return signedIn()
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email_verified == true
          && request.auth.token.email != null;
      }
      function myEmail() { return request.auth.token.email.lower(); }

      // The household's data. Owners get everything.
      match /{collection}/{docId} {
        allow read, write: if isOwner()
          && collection in ['events', 'health', 'weights', 'settings', 'treatments', 'training', 'photos', 'photoFull', 'devices'];
        // Sitters: read events and settings (the sitter guide), add events, and change only their own.
        allow read: if isSitter() && collection in ['events', 'settings'];
        allow create: if isSitter() && collection == 'events'
          && request.resource.data.keys().hasOnly(eventFields())
          && request.resource.data.byUid == request.auth.uid;
        allow update: if isSitter() && collection == 'events'
          && resource.data.byUid == request.auth.uid
          && request.resource.data.keys().hasOnly(eventFields())
          && request.resource.data.byUid == request.auth.uid;
        allow delete: if isSitter() && collection == 'events' && resource.data.byUid == request.auth.uid;
      }

      // Sitter invites. The invite (name and dates) can be fetched by anyone signed in who knows its long random id;
      // the PIN lives in a separate owner-only document, so knowing the link is not enough.
      match /invites/{inviteId} {
        allow get: if validHid() && signedIn() && inviteId.size() >= 16;
        allow list: if isOwner();
        allow create, update: if isOwner() && inviteId.size() >= 16
          && request.resource.data.keys().hasOnly(['name', 'startsAt', 'expiresAt', 'createdAt'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.startsAt is timestamp && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.resource.data.startsAt;
        allow delete: if isOwner();
      }
      match /invitePins/{inviteId} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner() && inviteId.size() >= 16
          && request.resource.data.keys().hasOnly(['pin'])
          && request.resource.data.pin is string && request.resource.data.pin.matches('[0-9]{6}');
      }

      // Who is an owner. The first Google account to arrive creates this list (containing itself);
      // after that only an existing owner can change it (e.g. to add the partner's email).
      match /meta/owners {
        allow read: if isOwner();
        allow create: if validHid() && googleEmail()
          && !exists(ownersPath())
          && request.resource.data.keys().hasOnly(['emails'])
          && request.resource.data.emails is list
          && request.resource.data.emails.size() >= 1 && request.resource.data.emails.size() <= 2
          && myEmail() in request.resource.data.emails;
        allow update: if isOwner()
          && request.resource.data.keys().hasOnly(['emails'])
          && request.resource.data.emails is list
          && request.resource.data.emails.size() >= 1 && request.resource.data.emails.size() <= 2
          && myEmail() in request.resource.data.emails;   // an owner can't lock themselves out
      }

      match /members/{uid} {
        // You can read your own record (to learn your role); owners can read everyone's.
        allow read: if validHid() && signedIn() && (request.auth.uid == uid || isOwner());
        // An owner claims their own record, if their verified Google email is on the owners list.
        allow create: if validHid() && signedIn() && request.auth.uid == uid && sitterClaim();
        allow create: if validHid() && googleEmail() && request.auth.uid == uid
          && exists(ownersPath())
          && myEmail() in get(ownersPath()).data.emails
          && request.resource.data.keys().hasOnly(['role', 'name', 'email', 'createdAt'])
          && request.resource.data.role == 'owner'
          && request.resource.data.email == myEmail();
        allow update, delete: if isOwner();
      }
    }
  }
}
